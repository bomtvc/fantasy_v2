# Environment Configuration Template
# Copy this to .env and fill in your values.
# Mọi biến ở đây đều được config.py đọc qua python-dotenv.

# --- Flask ---
# Bắt buộc đặt trước khi deploy. Sinh khoá: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=False
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO

# Domain được phép gọi /api/* qua CORS, phân tách bằng dấu phẩy.
# Để trống = tắt CORS (đúng cho trường hợp giao diện do chính app này phục vụ).
CORS_ORIGINS=

# Token cho /api/cache/clear và /api/cache/stats khi gọi từ script/CLI
# (header X-Admin-Token). Request từ chính giao diện app luôn được chấp nhận.
ADMIN_TOKEN=

# --- FPL API ---
FPL_BASE_URL=https://fantasy.premierleague.com/api
REQUEST_TIMEOUT=10
MAX_RETRIES=3
RETRY_BACKOFF=0.5
REQUEST_DELAY=0.3
MAX_WORKERS=6
HTTP_POOL_SIZE=12

# --- Cache ---
# Mặc định là <project>/cache (đường dẫn tuyệt đối)
CACHE_DIR=
CACHE_THRESHOLD=50000
CACHE_DEFAULT_TIMEOUT=300

# TTL theo loại dữ liệu (giây)
BOOTSTRAP_CACHE_TTL=3600
LEAGUE_CACHE_TTL=3600
GW_DATA_CACHE_TTL=900
API_CACHE_TTL=300
# GW đã chốt điểm là dữ liệu bất biến nên cache rất dài
FINISHED_GW_CACHE_TTL=604800

# --- Defaults ---
DEFAULT_LEAGUE_ID=1644718
DEFAULT_PHASE=1
DEFAULT_MONTH_MAPPING=1-4,5-8,9-12,13-16,17-20,21-24,25-28,29-32,33-36,37-38

# --- Prize money (VND) ---
WEEKLY_PRIZE=300000
MONTHLY_PRIZE=500000

# --- UI ---
PAGE_TITLE=RSC Fantasy League
